# D'Angelo's Pizzeria - Git Ignore

# Cache directories
cache/
api/cache/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log
error_log
access_log

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Backup files
*.bak
*.backup

# Environment files (if used)
.env
.env.local
.env.production

# Node modules (if using build tools)
node_modules/

# Composer (if using PHP dependencies)
vendor/

# Build files
dist/
build/

# Database files
*.sql
*.sqlite
*.db

# Large media files (optional - uncomment if needed)
# *.mp4
# *.mov
# *.avi

# Configuration backups
config.json.bak
config.json.backup

